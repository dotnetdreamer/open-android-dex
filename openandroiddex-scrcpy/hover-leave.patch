 }
 
+// Open Android DeX: the pointer left the window with nothing held. Android is
+// told the hover is over, as a computer's own windows are, so whatever was
+// under the pointer stops showing itself hovered rather than staying lit until
+// the pointer comes back. Only for a mouse the computer draws: a captured one
+// (relative mode) never leaves.
+static void
+sc_input_manager_process_mouse_leave(struct sc_input_manager *im) {
+    if (!im->mouse_hovering || im->mouse_buttons_state || !im->controller
+            || im->camera || !im->mp || im->mp->relative_mode
+            || im->screen->paused || im->disconnected) {
+        return;
+    }
+    im->mouse_hovering = false;
+
+    struct sc_control_msg msg = {
+        .type = SC_CONTROL_MSG_TYPE_INJECT_TOUCH_EVENT,
+        .inject_touch_event = {
+            .action = AMOTION_EVENT_ACTION_HOVER_EXIT,
+            .pointer_id = SC_POINTER_ID_MOUSE,
+            .position = im->hover_position,
+            .pressure = 0.f,
+            .action_button = 0,
+            .buttons = 0,
+        },
+    };
+
+    if (!sc_controller_push_msg(im->controller, &msg)) {
+        LOGW("Could not request 'inject hover exit'");
+    }
+}
+
 void
 sc_input_manager_handle_event(struct sc_input_manager *im,
                               const SDL_Event *event) {
     switch (event->type) {
+        case SDL_EVENT_WINDOW_MOUSE_LEAVE:
+            sc_input_manager_process_mouse_leave(im);
+            break;
         case SDL_EVENT_TEXT_INPUT:
             sc_input_manager_process_text_input(im, &event->text);
             break;
