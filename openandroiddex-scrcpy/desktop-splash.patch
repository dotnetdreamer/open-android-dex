+package com.genymobile.scrcpy.opengl;
+
+/**
+ * A filter that moves by itself (Open Android DeX: the desktop's splash).
+ *
+ * <p>{@link OpenGLRunner} draws an ordinary filter when its input has a new frame, which on an idle
+ * display is never. While this one {@link #isAnimating() is animating}, the runner draws it on a clock
+ * of its own instead, whether the input has a new frame or not.
+ */
+public interface AnimatedOpenGLFilter extends OpenGLFilter {
+
+    /** Whether the next frame differs even if the input does not. */
+    boolean isAnimating();
+
+    /** The input has delivered its first frame: until then, its texture holds nothing to read. */
+    void onFirstFrame();
+}
