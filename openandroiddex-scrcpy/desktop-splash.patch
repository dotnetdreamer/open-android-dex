+    private final DesktopSplash splash;
+    private final Size size;
+    private final Runnable onDone;
+
+    private FloatBuffer vertexBuffer;
+
+    private int copyProgram;
+    private int copyVertexPosLoc;
+    private int copyTexLoc;
+    private int copyTexMatrixLoc;
+
+    private int program; // 0 when the splash could not be built: the display is then copied as it is
+    private int vertexPosLoc;
+    private int resLoc;
+    private int timeLoc;
+    private int revealLoc;
+    private int texMatrixLoc;
+    private int deskLoc;
+    private int wordLoc;
+    private int wordSizeLoc;
+
+    private int wordTexture;
+    private float wordWidth; // on the display; 0 without the name
+    private float wordHeight;
+
+    private int probeFramebuffer;
+    private int probeTexture;
+    private ByteBuffer probePixels;
+
+    private boolean hasFrame;
+    private int frames;
+    private int drawnProbes;
+    private boolean doneSignalled;
+
+    /**
+     * @param size   the size drawn at, the encoder's
+     * @param onDone run once the splash is over and the filter only copies the display: the capture
+     *               may then go back to the display alone
+     */
+    public DesktopSplashFilter(DesktopSplash splash, Size size, Runnable onDone) {
+        this.splash = splash;
+        this.size = size;
+        this.onDone = onDone;
+    }
+
+    @Override
+    public void init() throws OpenGLException {
+        vertexBuffer = GLUtils.createFloatBuffer(new float[] {
+                -1, -1, // Bottom-left
+                1, -1, // Bottom-right
+                -1, 1, // Top-left
+                1, 1, // Top-right
+        });
+
+        copyProgram = GLUtils.createProgram(COPY_VERTEX, COPY_FRAGMENT);
+        if (copyProgram == 0) {
+            throw new OpenGLException("Cannot create OpenGL program");
+        }
+        copyVertexPosLoc = GLES20.glGetAttribLocation(copyProgram, "vertex_pos");
+        copyTexLoc = GLES20.glGetUniformLocation(copyProgram, "tex");
+        copyTexMatrixLoc = GLES20.glGetUniformLocation(copyProgram, "tex_matrix");
+
+        if (!initProbe()) {
+            Ln.w("Desktop splash: cannot watch the display on this GPU, it shows as it is");
+            splash.finish();
+            return;
+        }
+
+        program = GLUtils.createProgram(SPLASH_VERTEX, SPLASH_FRAGMENT);
+        if (program == 0) {
+            Ln.w("Desktop splash: this GPU does not build its shader, the display shows as it is");
+            splash.finish();
+            return;
+        }
+        vertexPosLoc = GLES20.glGetAttribLocation(program, "vertex_pos");
+        resLoc = GLES20.glGetUniformLocation(program, "uRes");
+        timeLoc = GLES20.glGetUniformLocation(program, "uTime");
+        revealLoc = GLES20.glGetUniformLocation(program, "uReveal");
+        texMatrixLoc = GLES20.glGetUniformLocation(program, "uTexMatrix");
+        deskLoc = GLES20.glGetUniformLocation(program, "uDesk");
+        wordLoc = GLES20.glGetUniformLocation(program, "uWord");
+        wordSizeLoc = GLES20.glGetUniformLocation(program, "uWordSize");
+
+        initWordmark();
+    }
+
+    private boolean initProbe() {
+        int[] ids = new int[1];
+        GLES20.glGenTextures(1, ids, 0);
+        probeTexture = ids[0];
+        GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, probeTexture);
+        GLES20.glTexImage2D(GLES20.GL_TEXTURE_2D, 0, GLES20.GL_RGBA, PROBE_W, PROBE_H, 0, GLES20.GL_RGBA,
+                GLES20.GL_UNSIGNED_BYTE, null);
+        setLinearClamp();
+
+        GLES20.glGenFramebuffers(1, ids, 0);
+        probeFramebuffer = ids[0];
+        GLES20.glBindFramebuffer(GLES20.GL_FRAMEBUFFER, probeFramebuffer);
+        GLES20.glFramebufferTexture2D(GLES20.GL_FRAMEBUFFER, GLES20.GL_COLOR_ATTACHMENT0, GLES20.GL_TEXTURE_2D,
+                probeTexture, 0);
+        int status = GLES20.glCheckFramebufferStatus(GLES20.GL_FRAMEBUFFER);
+        GLES20.glBindFramebuffer(GLES20.GL_FRAMEBUFFER, 0);
+
+        probePixels = ByteBuffer.allocateDirect(PROBE_W * PROBE_H * 4).order(ByteOrder.nativeOrder());
+        return status == GLES20.GL_FRAMEBUFFER_COMPLETE;
+    }
+
+    /**
+     * The name, from its picture. Power-of-two sized, so it can have mipmaps, which is what keeps it
+     * smooth at the size it is drawn at: about a third of the picture's on a 1080p desktop. Without
+     * it, the splash is the mark alone.
+     */
+    private void initWordmark() {
+        Bitmap bitmap = null;
+        try {
+            StringBuilder png = new StringBuilder();
+            for (String part : DesktopSplashWordmark.PNG_BASE64) {
+                png.append(part);
+            }
+            byte[] bytes = Base64.decode(png.toString(), Base64.DEFAULT);
+            bitmap = BitmapFactory.decodeByteArray(bytes, 0, bytes.length);
+        } catch (IllegalArgumentException e) {
+            // reported below
+        }
+        if (bitmap == null) {
+            Ln.w("Desktop splash: its name does not decode, the mark plays without it");
+            return;
+        }
+        int[] ids = new int[1];
+        GLES20.glGenTextures(1, ids, 0);
+        wordTexture = ids[0];
+        GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, wordTexture);
+        setLinearClamp();
+        android.opengl.GLUtils.texImage2D(GLES20.GL_TEXTURE_2D, 0, bitmap, 0);
+        GLES20.glGenerateMipmap(GLES20.GL_TEXTURE_2D);
+        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_MIN_FILTER, GLES20.GL_LINEAR_MIPMAP_LINEAR);
+        wordHeight = WORD_TEXT_SIZE * WORD_PICTURE_HEIGHT * size.getHeight();
+        wordWidth = wordHeight * bitmap.getWidth() / bitmap.getHeight();
+        bitmap.recycle();
+    }
+
+    private static void setLinearClamp() {
+        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_MIN_FILTER, GLES20.GL_LINEAR);
+        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_MAG_FILTER, GLES20.GL_LINEAR);
+        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_WRAP_S, GLES20.GL_CLAMP_TO_EDGE);
+        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_WRAP_T, GLES20.GL_CLAMP_TO_EDGE);
+    }
+
+    @Override
+    public boolean isAnimating() {
+        return program != 0 && !splash.isDone();
+    }
+
+    @Override
+    public void onFirstFrame() {
+        hasFrame = true;
+    }
+
+    @Override
+    public void draw(int textureId, float[] texMatrix) {
+        if (program == 0 || splash.isDone()) {
+            copy(textureId, texMatrix);
+            signalDone();
+            return;
+        }
+
+        long now = System.nanoTime();
+        float time = splash.time(now);
+        if (hasFrame && !splash.isReady() && ++frames % PROBE_EVERY == 0) {
+            // Twice in a row, a tenth of a second apart: drawn, and staying drawn
+            drawnProbes = probe(textureId, texMatrix) ? drawnProbes + 1 : 0;
+            if (drawnProbes >= 2) {
+                splash.ready(now);
+            }
+        }
+        float reveal = splash.reveal(now);
+
+        GLES20.glUseProgram(program);
+        GLES20.glEnableVertexAttribArray(vertexPosLoc);
+        GLES20.glVertexAttribPointer(vertexPosLoc, 2, GLES20.GL_FLOAT, false, 0, vertexBuffer);
+
+        GLES20.glActiveTexture(GLES20.GL_TEXTURE1);
+        GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, wordTexture);
+        GLES20.glUniform1i(wordLoc, 1);
+        GLES20.glActiveTexture(GLES20.GL_TEXTURE0);
+        GLES20.glBindTexture(GLES11Ext.GL_TEXTURE_EXTERNAL_OES, textureId);
+        GLES20.glUniform1i(deskLoc, 0);
+
+        GLES20.glUniform2f(wordSizeLoc, wordWidth, wordHeight);
+        GLES20.glUniform2f(resLoc, size.getWidth(), size.getHeight());
+        GLES20.glUniform1f(timeLoc, time);
+        GLES20.glUniform1f(revealLoc, reveal);
+        GLES20.glUniformMatrix4fv(texMatrixLoc, 1, false, texMatrix, 0);
+
+        GLES20.glDrawArrays(GLES20.GL_TRIANGLE_STRIP, 0, 4);
+        GLUtils.checkGlError();
+
+        if (reveal >= 1f) {
+            // This frame was the display one pixel for one: nothing of the splash is left in it
+            splash.finish();
+            Ln.i("Desktop splash: the desktop is open");
+            signalDone();
+        }
+    }
+
+    /** The display as it is. */
+    private void copy(int textureId, float[] texMatrix) {
+        GLES20.glUseProgram(copyProgram);
+        GLES20.glEnableVertexAttribArray(copyVertexPosLoc);
+        GLES20.glVertexAttribPointer(copyVertexPosLoc, 2, GLES20.GL_FLOAT, false, 0, vertexBuffer);
+        GLES20.glActiveTexture(GLES20.GL_TEXTURE0);
+        GLES20.glBindTexture(GLES11Ext.GL_TEXTURE_EXTERNAL_OES, textureId);
+        GLES20.glUniform1i(copyTexLoc, 0);
+        GLES20.glUniformMatrix4fv(copyTexMatrixLoc, 1, false, texMatrix, 0);
+        GLES20.glDrawArrays(GLES20.GL_TRIANGLE_STRIP, 0, 4);
+        GLUtils.checkGlError();
+    }
+
+    /**
+     * Has the display stopped being a fill? An empty display is black, and the starting window
+     * Android shows while the launcher starts is its splash colour with the icon in the middle:
+     * outside the middle, both are a single colour to the last bit. The desktop is not: wallpaper,
+     * icons and the taskbar along the bottom edge.
+     */
+    private boolean probe(int textureId, float[] texMatrix) {
+        GLES20.glBindFramebuffer(GLES20.GL_FRAMEBUFFER, probeFramebuffer);
+        GLES20.glViewport(0, 0, PROBE_W, PROBE_H);
+        copy(textureId, texMatrix);
+        probePixels.clear();
+        GLES20.glReadPixels(0, 0, PROBE_W, PROBE_H, GLES20.GL_RGBA, GLES20.GL_UNSIGNED_BYTE, probePixels);
+        GLES20.glBindFramebuffer(GLES20.GL_FRAMEBUFFER, 0);
+        GLES20.glViewport(0, 0, size.getWidth(), size.getHeight());
+
+        int[] min = {255, 255, 255};
+        int[] max = {0, 0, 0};
+        for (int y = 0; y < PROBE_H; ++y) {
+            for (int x = 0; x < PROBE_W; ++x) {
+                if (x >= ICON_X0 && x < ICON_X1 && y >= ICON_Y0 && y < ICON_Y1) {
+                    continue;
+                }
+                int i = (y * PROBE_W + x) * 4;
+                for (int c = 0; c < 3; ++c) {
+                    int v = probePixels.get(i + c) & 0xFF;
+                    min[c] = Math.min(min[c], v);
+                    max[c] = Math.max(max[c], v);
+                }
+            }
+        }
+        for (int c = 0; c < 3; ++c) {
+            if (max[c] - min[c] >= PROBE_SPREAD) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private void signalDone() {
+        if (!doneSignalled) {
+            doneSignalled = true;
+            onDone.run();
+        }
+    }
+
+    @Override
+    public void release() {
+        GLES20.glDeleteProgram(copyProgram);
+        if (program != 0) {
+            GLES20.glDeleteProgram(program);
+        }
+        int[] textures = {probeTexture, wordTexture};
+        GLES20.glDeleteTextures(2, textures, 0);
+        int[] framebuffers = {probeFramebuffer};
+        GLES20.glDeleteFramebuffers(1, framebuffers, 0);
+        GLUtils.checkGlError();
+    }
+}
