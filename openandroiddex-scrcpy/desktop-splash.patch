+            + "    }\n"
+            + "\n"
+            + "    // Contact shadow under the laptop.\n"
+            + "    float deckP = outCubic(prog(t, 0.82, 1.24));\n"
+            + "    float deckA = deckP * (1.0 - smoothstep(0.15, 0.55, rv));\n"
+            + "    vec2 ds = (q - vec2(575.92, 718.0)) / vec2(330.0, 22.0);\n"
+            + "    col *= 1.0 - 0.6 * exp(-dot(ds, ds)) * deckA;\n"
+            + "\n"
+            + "    // Bezel.\n"
+            + "    float bezA = sat(open * 1.6) * logoFade;\n"
+            + "    vec2 bh = sh + 18.8 * open;\n"
+            + "    float br = mix(sr, 35.72, open);\n"
+            + "    vec3 bez = mix(BEZ_T, BEZ_B, sat((q.y - 312.72) / 364.72));\n"
+            + "    col = mix(col, bez + band * 0.10, cover(sdBox(q - SCR_O, bh, br), aa) * bezA);\n"
+            + "\n"
+            + "    // Screen, and the desktop drawn on it.\n"
+            + "    float cS = cover(dS, aa) * lit;\n"
+            + "    if (cS > 0.0) {\n"
+            + "        vec2 D = vec2(460.60, 338.40);\n"
+            + "        float g = sat(dot(q - vec2(349.38, 312.72), D) / dot(D, D));\n"
+            + "        vec3 sc = g < 0.5 ? mix(SCR_A, SCR_B, g * 2.0) : mix(SCR_B, SCR_C, g * 2.0 - 1.0);\n"
+            + "\n"
+            + "        float content = 1.0 - deskMix;\n"
+            + "        float stripA = prog(t, 0.95, 1.25) * 0.5 * content;\n"
+            + "        sc = mix(sc, STRIP, sat((q.y - 615.40) / aa + 0.5) * stripA);\n"
+            + "        for (int i = 0; i < 3; i++) {\n"
+            + "            float fi = float(i);\n"
+            + "            float pop = outBack(prog(t, 1.30 + 0.07 * fi, 1.52 + 0.07 * fi));\n"
+            + "            if (pop > 0.001) {\n"
+            + "                vec2 dq = (q - vec2(544.90 + 31.96 * fi, 637.02)) / pop;\n"
+            + "                float dd = sdBox(dq, vec2(11.28), 7.52) * pop;\n"
+            + "                vec3 dcol = i == 2 ? MINT : vec3(1.0);\n"
+            + "                float da = i == 1 ? 0.5 : 1.0;\n"
+            + "                sc = mix(sc, dcol, cover(dd, aa) * da * content);\n"
+            + "            }\n"
+            + "        }\n"
+            + "\n"
+            + "        float winA = outCubic(prog(t, 1.00, 1.22)) * content;\n"
+            + "        if (winA > 0.0) {\n"
+            + "            float ws = mix(0.80, 1.0, outBack(prog(t, 1.00, 1.42)));\n"
+            + "            vec2 wl = (q - vec2(603.18, 477.22)) / ws;\n"
+            + "            float wa = aa / ws;\n"
+            + "            vec3 wc = mix(vec3(1.0), WIN_B, sat((wl.y + 96.82) / 193.64));\n"
+            + "            wc = mix(wc, TITLE, sat((-61.10 - wl.y) / wa + 0.5));\n"
+            + "            float gp = outBack(prog(t, 1.18, 1.36));\n"
+            + "            float rp = outBack(prog(t, 1.24, 1.42));\n"
+            + "            wc = mix(wc, GREY, cover(length(wl - vec2(92.12, -78.96)) - 7.52 * gp, wa) * step(0.001, gp));\n"
+            + "            wc = mix(wc, RED, cover(length(wl - vec2(116.56, -78.96)) - 7.52 * rp, wa) * step(0.001, rp));\n"
+            + "\n"
+            + "            float tp = outBack(prog(t, 1.12, 1.46));\n"
+            + "            if (tp > 0.001) {\n"
+            + "                vec2 tl = wl - vec2(-73.32, 15.98);\n"
+            + "                vec2 tq = vec2(tl.x / mix(0.7, 1.0, tp), (tl.y - 56.40) / tp + 56.40);\n"
+            + "                float tg = mix(0.153, 0.506, sat((tq.y + 56.40) / 112.80));\n"
+            + "                wc = mix(wc, mix(MINT, GREEN, tg), cover(sdBox(tq, vec2(45.12, 56.40), 13.16), wa));\n"
+            + "            }\n"
+            + "            for (int i = 0; i < 3; i++) {\n"
+            + "                float fi = float(i);\n"
+            + "                float lp = outCubic(prog(t, 1.22 + 0.07 * fi, 1.52 + 0.07 * fi));\n"
+            + "                if (lp > 0.001) {\n"
+            + "                    float w = i == 0 ? 124.08 : (i == 1 ? 97.76 : 110.92);\n"
+            + "                    float hh = i == 0 ? 6.58 : 5.17;\n"
+            + "                    float y = i == 0 ? -28.20 : (i == 1 ? -1.41 : 21.15);\n"
+            + "                    float la = i == 0 ? 0.70 : 0.22;\n"
+            + "                    float hw = max(0.5 * w * lp, hh);\n"
+            + "                    float dl = sdBox(wl - vec2(-11.28 + hw, y), vec2(hw, hh), hh);\n"
+            + "                    wc = mix(wc, INK, cover(dl, wa) * la);\n"
+            + "                }\n"
+            + "            }\n"
+            + "            sc = mix(sc, wc, cover(sdBox(wl, vec2(141.0, 96.82), 20.68) * ws, aa) * winA);\n"
+            + "        }\n"
+            + "\n"
+            + "        sc += exp(-(t - 1.80) * (t - 1.80) / 0.012) * 0.16 * content;\n"
+            + "        sc = mix(sc, HOT, hot);\n"
+            + "        sc += band * 0.30;\n"
+            + "        col = mix(col, sc, cS);\n"
+            + "    }\n"
+            + "\n"
+            + "    // Through the screen: the real desktop, once the phone has drawn it.\n"
+            + "    if (rv > 0.0) {\n"
+            + "        float f = smoothstep(0.58, 1.0, rv);\n"
+            + "        vec2 pc = mix(T + (SCR_O - A) * K, 0.5 * res, f);\n"
+            + "        vec2 ph = mix(SCR_H * K, 0.5 * res, f);\n"
+            + "        float pr = mix(18.8 * K, 0.0, f);\n"
+            + "        float dP = sdBox(p - pc, ph, min(pr, min(ph.x, ph.y)));\n"
+            + "        float pm = cover(dP, 1.0);\n"
+            + "        if (pm > 0.0) {\n"
+            + "            float s = max(ph.x / (0.5 * res.x), ph.y / (0.5 * res.y));\n"
+            + "            vec3 dk = desk(0.5 + (p - pc) / (res * s));\n"
+            + "            float light = mix(0.80, 1.0, smoothstep(0.35, 1.0, rv));\n"
+            + "            float vig = mix(1.0, 0.62 + 0.38 * smoothstep(0.0, 0.22 * min(ph.x, ph.y), -dP), 1.0 - f);\n"
+            + "            col = mix(col, dk * light * vig, pm * deskMix);\n"
+            + "        }\n"
+            + "    }\n"
+            + "\n"
+            + "    // Highlight along the bezel.\n"
+            + "    float dB = abs(sdBox(q - SCR_O, bh - 1.41, br - 1.41)) - 1.41;\n"
+            + "    col = mix(col, vec3(1.0), cover(dB, aa) * (0.20 + band * 0.6) * bezA);\n"
+            + "\n"
+            + "    // The laptop's deck.\n"
+            + "    if (deckA > 0.0) {\n"
+            + "        vec2 dl = q - vec2(575.92, 694.36 + 18.0 * (1.0 - deckP));\n"
+            + "        dl.x /= mix(0.72, 1.0, deckP);\n"
+            + "        float rr = dl.y > 0.0 ? 26.32 : 0.0;\n"
+            + "        vec2 qq = abs(dl) - vec2(281.06, 16.92) + rr;\n"
+            + "        float dd = length(max(qq, 0.0)) + min(max(qq.x, qq.y), 0.0) - rr;\n"
+            + "        vec3 dcol = mix(DECK_T, DECK_B, sat((dl.y + 16.92) / 33.84));\n"
+            + "        dcol = mix(dcol, INK, cover(sdBox(dl - vec2(0.0, -12.22), vec2(42.30, 4.70), 4.70), aa) * 0.18);\n"
+            + "        col = mix(col, dcol + band * 0.22, cover(dd, aa) * deckA);\n"
+            + "    }\n"
+            + "\n"
+            + "    // Connected: light ripples out from behind the phone as it lands.\n"
+            + "    for (int i = 0; i < 2; i++) {\n"
+            + "        float fi = float(i);\n"
+            + "        float rT = prog(t, 1.48 + 0.18 * fi, 2.35 + 0.18 * fi);\n"
+            + "        if (rT > 0.0 && rT < 1.0) {\n"
+            + "            float dR = abs(sdBox(q - PH_O, vec2(114.68, 193.42), 69.56) - mix(4.0, 170.0, outCubic(rT)))\n"
+            + "                    - mix(3.0, 0.8, rT);\n"
+            + "            float ra = (1.0 - rT) * (1.0 - rT) * (0.60 - 0.25 * fi) * logoFade;\n"
+            + "            col += mix(MINT, CYAN, rT) * (cover(dR, aa) + exp(-max(dR, 0.0) / 14.0) * 0.5) * ra;\n"
+            + "        }\n"
+            + "    }\n"
+            + "\n"
+            + "    // The phone: it swings in, lands in front of the laptop and lights up, and\n"
+            + "    // is the first thing out of the way when the desktop opens.\n"
+            + "    float phP = prog(t, 0.98, 1.62);\n"
+            + "    float phOut = prog(rv, 0.0, 0.55);\n"
+            + "    float phA = outCubic(prog(t, 0.98, 1.24)) * (1.0 - smoothstep(0.05, 0.45, rv));\n"
+            + "    if (phA > 0.0) {\n"
+            + "        float rot = 0.22 * (1.0 - outCubic(phP)) + 0.30 * phOut * phOut;\n"
+            + "        vec2 off = vec2(-150.0 * (1.0 - outBack(phP)) - 420.0 * phOut * phOut * phOut, 60.0 * phOut * phOut);\n"
+            + "        vec2 pq0 = q - PH_O - off;\n"
+            + "        float cr = cos(rot), sr2 = sin(rot);\n"
+            + "        vec2 pq = vec2(cr * pq0.x - sr2 * pq0.y, sr2 * pq0.x + cr * pq0.y);\n"
+            + "\n"
+            + "        float shd = 1.0 - smoothstep(-24.0, 40.0, sdBox(pq - vec2(18.0, 16.0), vec2(114.68, 193.42), 69.56));\n"
+            + "        col *= 1.0 - 0.42 * shd * phA;\n"
+            + "        vec2 fs = (q - PH_O - off - vec2(12.0, 202.0)) / vec2(135.0, 16.0);\n"
+            + "        col *= 1.0 - 0.5 * exp(-dot(fs, fs)) * phA;\n"
+            + "\n"
+            + "        float yy = pq.y + PH_O.y;\n"
+            + "        vec3 body = mix(BODY_T, BODY_B, sat((yy + 175.06) / 1396.68));\n"
+            + "        col = mix(col, body + band * 0.12, cover(sdBox(pq, vec2(114.68, 193.42), 69.56), aa) * phA);\n"
+            + "        vec3 pb = mix(BEZ_T, BEZ_B, sat((yy - 369.12) / 342.16));\n"
+            + "        col = mix(col, pb, cover(sdBox(pq - vec2(0.0, 0.22), vec2(92.12, 171.08), 47.0), aa) * phA);\n"
+            + "\n"
+            + "        float on = outCubic(prog(t, 1.30, 1.72));\n"
+            + "        float front = 382.28 + 380.0 * on;\n"
+            + "        float litM = 1.0 - smoothstep(front - 46.0, front, yy);\n"
+            + "        vec3 ps = mix(UNLIT, mix(MINT, GREEN, sat((yy - 387.92) / 319.6)), litM) + band * 0.22;\n"
+            + "        col = mix(col, ps, cover(sdBox(pq - vec2(0.0, 0.09), vec2(78.96, 157.79), 34.78), aa) * phA);\n"
+            + "        col = mix(col, INK, cover(length(pq - vec2(0.0, -135.14)) - 7.52, aa) * 0.75 * phA * sat(on * 2.0));\n"
+            + "        float dps = abs(sdBox(pq - vec2(0.0, 0.22), vec2(90.71, 169.67), 45.59)) - 1.41;\n"
+            + "        col = mix(col, vec3(1.0), cover(dps, aa) * 0.20 * phA);\n"
+            + "    }\n"
+            + "\n"
+            + "    // The name, and while the phone is still busy, a quiet sign that it is.\n"
+            + "    if (uWordSize.x > 0.0) {\n"
+            + "        float top = C.y + LOGO_H.y * S + 0.068 * res.y;\n"
+            + "        float wA = prog(t, 1.45, 1.80) * (1.0 - smoothstep(0.0, 0.22, rv));\n"
+            + "        if (wA > 0.0) {\n"
+            + "            float drift = 12.0 * (1.0 - outCubic(prog(t, 1.45, 2.10))) + 16.0 * smoothstep(0.0, 0.22, rv);\n"
+            + "            vec2 wuv = (p - vec2(0.5 * (res.x - uWordSize.x), top + drift)) / uWordSize;\n"
+            + "            if (wuv.x >= 0.0 && wuv.x <= 1.0 && wuv.y >= 0.0 && wuv.y <= 1.0) {\n"
+            + "                vec4 tx = texture2D(uWord, wuv);\n"
+            + "                float e = mix(-0.2, 1.25, outCubic(prog(t, 1.45, 2.20)));\n"
+            + "                float k = wA * (1.0 - smoothstep(e - 0.2, e, wuv.x));\n"
+            + "                float sz = (wuv.x - mix(-0.3, 1.3, prog(t, 2.20, 2.95))) / 0.07;\n"
+            + "                float shim = exp(-sz * sz) * step(2.20, t);\n"
+            + "                col = col * (1.0 - tx.a * k) + (tx.rgb + shim * 0.55 * tx.a) * k;\n"
+            + "            }\n"
+            + "        }\n"
+            + "        float pa = smoothstep(2.6, 3.1, t) * (1.0 - smoothstep(0.0, 0.15, rv));\n"
+            + "        if (pa > 0.0) {\n"
+            + "            float L = min(0.10 * res.x, 0.30 * uWordSize.x + 60.0);\n"
+            + "            float cy = top + uWordSize.y + 0.040 * res.y;\n"
+            + "            float u = (p.x - 0.5 * (res.x - L)) / L;\n"
+            + "            float dy = abs(p.y - cy);\n"
+            + "            if (u > 0.0 && u < 1.0 && dy < 4.0) {\n"
+            + "                float line = sat(1.25 - dy);\n"
+            + "                float ends = smoothstep(0.0, 0.15, u) * (1.0 - smoothstep(0.85, 1.0, u));\n"
+            + "                float hx = mix(-0.3, 1.3, fract((t - 2.6) / 1.7));\n"
+            + "                float glow = exp(-(u - hx) * (u - hx) / 0.012);\n"
+            + "                col += (vec3(0.07) + SCR_A * glow * 0.85) * line * ends * pa;\n"
+            + "            }\n"
+            + "        }\n"
+            + "    }\n"
+            + "\n"
+            + "    // A breath of noise, so the gradients survive the encoder without bands.\n"
+            + "    float n = fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));\n"
+            + "    col += (n - 0.5) * (1.5 / 255.0) * amb * (1.0 - smoothstep(0.55, 1.0, rv));\n"
+            + "    gl_FragColor = vec4(col, 1.0);\n"
+            + "}\n";
