+package com.genymobile.scrcpy.video;
+
+import com.genymobile.scrcpy.model.Size;
+import com.genymobile.scrcpy.opengl.AnimatedOpenGLFilter;
+import com.genymobile.scrcpy.opengl.GLUtils;
+import com.genymobile.scrcpy.opengl.OpenGLException;
+import com.genymobile.scrcpy.util.Ln;
+
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.opengl.GLES11Ext;
+import android.opengl.GLES20;
+import android.util.Base64;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.FloatBuffer;
+
+/**
+ * Draws the {@link DesktopSplash} over the display it is waiting for (Open Android DeX).
+ *
+ * <p>The whole splash is one fragment shader on the splash's clock. The mark is the launcher icon's
+ * drawing (open-android-dex-tauri/scripts/brand.py), as rounded boxes in the icon's own 1024 canvas,
+ * so it stays sharp while the view dives into the laptop's screen. Only the name is not drawn in the
+ * shader: it is a picture, desktop-splash-wordmark.png, which build.mjs puts in the server as
+ * {@link DesktopSplashWordmark}. Not type set here, because this process is not an app, and on a
+ * Samsung phone it cannot get a working Typeface at all (see doc/desktop-splash.md).
+ *
+ * <p>The filter also watches the display it draws over, through a {@value #PROBE_W}x{@value #PROBE_H}
+ * copy read back every few frames, for the moment it is no longer one colour outside its centre.
+ *
+ * <p>Anything here that cannot be had on a phone (a shader its GPU refuses, a framebuffer to read
+ * back from) ends the splash rather than the desktop: the display is then drawn as it is.
+ */
+public final class DesktopSplashFilter implements AnimatedOpenGLFilter {
+
+    private static final int PROBE_W = 32;
+    private static final int PROBE_H = 18;
+    /** Watch about ten times a second, until the desktop has drawn. */
+    private static final int PROBE_EVERY = 6;
+    /** A channel this far apart between two places outside the centre is a desktop, not a fill. */
+    private static final int PROBE_SPREAD = 8;
+    /** Where the starting window's icon sits, in probe pixels: not looked at. */
+    private static final int ICON_X0 = 9;
+    private static final int ICON_X1 = 23;
+    private static final int ICON_Y0 = 5;
+    private static final int ICON_Y1 = 13;
+    /** The name's text size, as a share of the display's height; its picture is 1.45 of that tall. */
+    private static final float WORD_TEXT_SIZE = 0.040f;
+    private static final float WORD_PICTURE_HEIGHT = 1.45f;
+
+    // @formatter:off
+    private static final String COPY_VERTEX = "#version 100\n"
+            + "attribute vec4 vertex_pos;\n"
+            + "varying vec2 tex_coords;\n"
+            + "uniform mat4 tex_matrix;\n"
+            + "void main() {\n"
+            + "    gl_Position = vertex_pos;\n"
+            + "    tex_coords = (tex_matrix * vec4(vertex_pos.xy * 0.5 + 0.5, 0.0, 1.0)).xy;\n"
+            + "}";
+
+    private static final String COPY_FRAGMENT = "#version 100\n"
+            + "#extension GL_OES_EGL_image_external : require\n"
+            + "precision highp float;\n"
+            + "uniform samplerExternalOES tex;\n"
+            + "varying vec2 tex_coords;\n"
+            + "void main() {\n"
+            + "    gl_FragColor = texture2D(tex, tex_coords);\n"
+            + "}";
+
+    private static final String SPLASH_VERTEX = "#version 100\n"
+            + "attribute vec4 vertex_pos;\n"
+            + "void main() {\n"
+            + "    gl_Position = vertex_pos;\n"
+            + "}";
+
+    private static final String SPLASH_FRAGMENT = "#version 100\n"
+            + "#extension GL_OES_EGL_image_external : require\n"
+            + "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+            + "precision highp float;\n"
+            + "#else\n"
+            + "precision mediump float;\n"
+            + "#endif\n"
+            + "#define DESK_SAMPLER samplerExternalOES\n"
+            + "uniform vec2 uRes;\n"
+            + "uniform float uTime;\n"
+            + "uniform float uReveal;\n"
+            + "uniform mat4 uTexMatrix;\n"
+            + "uniform DESK_SAMPLER uDesk;\n"
+            + "uniform sampler2D uWord;\n"
+            + "uniform vec2 uWordSize;\n"
+            + "\n"
+            + "const vec3 SKY_IN = vec3(0.050, 0.094, 0.180);\n"
+            + "const vec3 SKY_OUT = vec3(0.008, 0.016, 0.035);\n"
+            + "const vec3 BLOOM = vec3(0.137, 0.314, 0.847);\n"
+            + "const vec3 SCR_A = vec3(0.525, 0.784, 1.000);\n"
+            + "const vec3 SCR_B = vec3(0.302, 0.624, 1.000);\n"
+            + "const vec3 SCR_C = vec3(0.169, 0.345, 0.910);\n"
+            + "const vec3 BEZ_T = vec3(0.102, 0.137, 0.220);\n"
+            + "const vec3 BEZ_B = vec3(0.043, 0.067, 0.122);\n"
+            + "const vec3 INK = vec3(0.043, 0.067, 0.122);\n"
+            + "const vec3 WIN_B = vec3(0.886, 0.914, 0.957);\n"
+            + "const vec3 TITLE = vec3(0.875, 0.906, 0.953);\n"
+            + "const vec3 RED = vec3(1.000, 0.420, 0.420);\n"
+            + "const vec3 GREY = vec3(0.722, 0.769, 0.839);\n"
+            + "const vec3 MINT = vec3(0.525, 0.961, 0.753);\n"
+            + "const vec3 GREEN = vec3(0.133, 0.710, 0.451);\n"
+            + "const vec3 STRIP = vec3(0.027, 0.067, 0.173);\n"
+            + "const vec3 DECK_T = vec3(0.914, 0.933, 0.965);\n"
+            + "const vec3 DECK_B = vec3(0.682, 0.725, 0.796);\n"
+            + "const vec3 BODY_T = vec3(0.118, 0.165, 0.278);\n"
+            + "const vec3 BODY_B = vec3(0.039, 0.059, 0.114);\n"
+            + "const vec3 HOT = vec3(0.880, 0.950, 1.000);\n"
+            + "const vec3 CYAN = vec3(0.302, 0.820, 1.000);\n"
+            + "const vec3 VIOLET = vec3(0.545, 0.361, 0.965);\n"
+            + "const vec3 UNLIT = vec3(0.055, 0.086, 0.149);\n"
+            + "\n"
+            + "// The mark, in the 1024 canvas brand.py draws it in.\n"
+            + "const vec2 LOGO_C = vec2(500.72, 523.06);\n"
+            + "const vec2 LOGO_H = vec2(356.26, 210.34);\n"
+            + "const vec2 SCR_O = vec2(575.92, 495.08);\n"
+            + "const vec2 SCR_H = vec2(226.54, 163.56);\n"
+            + "const vec2 PH_O = vec2(259.14, 539.98);\n"
+            + "\n"
+            + "float sat(float x) { return clamp(x, 0.0, 1.0); }\n"
+            + "float prog(float t, float a, float b) { return sat((t - a) / (b - a)); }\n"
+            + "float outCubic(float x) { float y = 1.0 - x; return 1.0 - y * y * y; }\n"
+            + "float outExpo(float x) { return x >= 1.0 ? 1.0 : 1.0 - exp2(-10.0 * x); }\n"
+            + "float inOutCubic(float x) { return x < 0.5 ? 4.0 * x * x * x : 1.0 - pow(2.0 - 2.0 * x, 3.0) * 0.5; }\n"
+            + "float outBack(float x) { float y = x - 1.0; return 1.0 + 2.70158 * y * y * y + 1.70158 * y * y; }\n"
+            + "\n"
+            + "float sdBox(vec2 p, vec2 b, float r) {\n"
+            + "    vec2 q = abs(p) - b + r;\n"
+            + "    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;\n"
+            + "}\n"
+            + "\n"
+            + "float cover(float d, float aa) { return sat(0.5 - d / aa); }\n"
+            + "\n"
+            + "vec3 desk(vec2 uv) {\n"
+            + "    vec2 st = (uTexMatrix * vec4(uv.x, 1.0 - uv.y, 0.0, 1.0)).xy;\n"
+            + "    return texture2D(uDesk, st).rgb;\n"
+            + "}\n"
+            + "\n"
+            + "void main() {\n"
+            + "    vec2 res = uRes;\n"
+            + "    vec2 p = vec2(gl_FragCoord.x, res.y - gl_FragCoord.y);\n"
+            + "    float t = uTime;\n"
+            + "    float rv = uReveal;\n"
+            + "\n"
+            + "    // Where the mark sits, and the camera that dives into its screen.\n"
+            + "    float S = min(0.29 * res.y / (2.0 * LOGO_H.y), 0.44 * res.x / (2.0 * LOGO_H.x));\n"
+            + "    vec2 C = vec2(0.5 * res.x, 0.44 * res.y);\n"
+            + "    float dive = inOutCubic(prog(rv, 0.10, 1.0));\n"
+            + "    // Contain, not cover: the desktop inside the screen only ever grows towards one to one.\n"
+            + "    float kEnd = min(res.x / (2.0 * SCR_H.x), res.y / (2.0 * SCR_H.y));\n"
+            + "    float K = S * pow(kEnd / S, dive);\n"
+            + "    vec2 A = mix(LOGO_C, SCR_O, dive);\n"
+            + "    vec2 T = mix(C, 0.5 * res, dive);\n"
+            + "    vec2 q = A + (p - T) / K;\n"
+            + "    float aa = 1.2 / K;\n"
+            + "\n"
+            + "    float amb = outCubic(prog(t, 0.0, 1.1));\n"
+            + "    float waitT = max(t - 2.2, 0.0);\n"
+            + "    float logoFade = 1.0 - smoothstep(0.30, 0.80, rv);\n"
+            + "    float deskMix = smoothstep(0.02, 0.32, rv);\n"
+            + "\n"
+            + "    // Night sky: a navy room lit from the mark, and a few slow lights.\n"
+            + "    float dc = length((p - C) / res.y);\n"
+            + "    vec3 col = mix(SKY_IN, SKY_OUT, smoothstep(0.0, 1.05, dc));\n"
+            + "    float breath = 1.0 + 0.12 * sin(waitT * 1.3) * sat(waitT);\n"
+            + "    col += BLOOM * exp(-dc * dc / 0.07) * 0.34 * breath;\n"
+            + "    for (int i = 0; i < 5; i++) {\n"
+            + "        float fi = float(i);\n"
+            + "        vec2 bc = vec2(0.5 + 0.42 * sin(fi * 2.39 + 0.9 + t * 0.045),\n"
+            + "                       0.5 + 0.36 * sin(fi * 1.71 + 2.2 + t * 0.037)) * res;\n"
+            + "        float bs = res.y * (0.10 + 0.04 * fi);\n"
+            + "        vec2 dv = p - bc;\n"
+            + "        col += mix(CYAN, VIOLET, fract(fi * 0.47)) * exp(-dot(dv, dv) / (bs * bs)) * 0.04;\n"
+            + "    }\n"
+            + "    col *= amb * (1.0 - 0.6 * dive);\n"
+            + "\n"
+            + "    // Ignition: a line of light that opens into the laptop's screen.\n"
+            + "    float grow = outExpo(prog(t, 0.10, 0.55));\n"
+            + "    float open = outExpo(prog(t, 0.48, 0.98));\n"
+            + "    float hot = 1.0 - outCubic(prog(t, 0.72, 1.40));\n"
+            + "    vec2 sh = vec2(SCR_H.x * grow, mix(0.9, SCR_H.y, open));\n"
+            + "    float sr = min(18.8, sh.y);\n"
+            + "    float dS = sdBox(q - SCR_O, sh, sr);\n"
+            + "    float lit = step(0.0001, grow);\n"
+            + "\n"
+            + "    float halo = exp(-max(dS, 0.0) / mix(9.0, 34.0, open)) * (0.10 + 1.1 * hot) * lit;\n"
