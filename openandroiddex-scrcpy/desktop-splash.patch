@@ -0,0 +1,114 @@
+package com.genymobile.scrcpy.video;
+
+import com.genymobile.scrcpy.util.Ln;
+
+import java.io.File;
+
+/**
+ * The desktop's splash (Open Android DeX): what the stream shows while the desktop is not there yet.
+ *
+ * <p>A desktop starts as an empty display. The computer's window opens as soon as the stream does, and
+ * the launcher is only started on the display seconds later, once the computer has installed it and
+ * granted it everything it needs (adb.rs, adb_start_launcher). That wait used to be a black window.
+ * The stream carries this splash instead, from its very first frame: the mark draws itself and waits
+ * with the user, and once the launcher has drawn the desktop, the laptop's screen in the mark becomes
+ * a window onto it and the view dives through it, landing on the desktop one pixel for one.
+ * {@link DesktopSplashFilter} draws it.
+ *
+ * <p>Painted here, in the server, because the server is the one thing on the phone that is there for
+ * the whole wait: the launcher is force-stopped and often reinstalled during it.
+ *
+ * <p>Only a desktop asks for it. The computer writes {@link #FILE} just before it starts the desktop's
+ * client, and the server that makes the next display takes it and removes it, so the phone's app
+ * windows, which are displays of their own, never play it.
+ *
+ * <p>Nothing tells the server that the launcher has drawn, and nothing has to: an empty display is a
+ * single colour, and so is the starting window Android puts up while the launcher starts, everywhere
+ * but its centre. The first frame that is not is the desktop.
+ */
+public final class DesktopSplash {
+
+    public static final String FILE = "/data/local/tmp/oadx-desktop-splash";
+
+    /** Older than this, the file is a desktop that never started, not a request. */
+    private static final long FRESH_MS = 60_000;
+
+    /** The desktop never opens before the mark and its name have been seen whole. */
+    private static final long MIN_REVEAL_AT_NS = 2_300_000_000L;
+    /** The launcher's first frame is not quite its last: the taskbar is a window of its own. */
+    private static final long SETTLE_NS = 300_000_000L;
+    private static final long REVEAL_NS = 1_000_000_000L;
+    /**
+     * A launcher that never draws, or a desktop the probe cannot tell from a fill, must not keep the
+     * splash over the display for long: a minute, well past the slowest start measured (about 15 s,
+     * with a reinstall of the launcher).
+     */
+    private static final long GIVE_UP_NS = 60_000_000_000L;
+
+    private long startNs = -1;
+    private long readyNs = -1;
+    private long revealNs = -1;
+    private boolean done;
+
+    private DesktopSplash() {
+        // see claim()
+    }
+
+    /** The splash, if the computer asked for one for the display about to be made; else null. */
+    public static DesktopSplash claim() {
+        File file = new File(FILE);
+        if (!file.exists()) {
+            return null;
+        }
+        boolean fresh = System.currentTimeMillis() - file.lastModified() < FRESH_MS;
+        if (!file.delete()) {
+            Ln.w("Desktop splash: could not remove " + FILE);
+        }
+        return fresh ? new DesktopSplash() : null;
+    }
+
+    /** Seconds since the splash's first frame, which is the first call. */
+    public synchronized float time(long nowNs) {
+        if (startNs < 0) {
+            startNs = nowNs;
+            Ln.i("Desktop splash: playing");
+        }
+        return (nowNs - startNs) / 1e9f;
+    }
+
+    /** The launcher has drawn the desktop. */
+    public synchronized void ready(long nowNs) {
+        if (readyNs < 0) {
+            readyNs = nowNs;
+            Ln.i("Desktop splash: the desktop drew after " + (nowNs - startNs) / 1_000_000 + " ms");
+        }
+    }
+
+    public synchronized boolean isReady() {
+        return readyNs >= 0;
+    }
+
+    /** How far the desktop has opened: 0 until it may, then up to 1 at one pixel for one. */
+    public synchronized float reveal(long nowNs) {
+        if (revealNs < 0) {
+            if (readyNs >= 0) {
+                revealNs = Math.max(readyNs + SETTLE_NS, startNs + MIN_REVEAL_AT_NS);
+            } else if (startNs >= 0 && nowNs - startNs >= GIVE_UP_NS) {
+                Ln.w("Desktop splash: nothing drew in " + GIVE_UP_NS / 1_000_000_000L + " s, opening the display as it is");
+                revealNs = nowNs;
+            } else {
+                return 0f;
+            }
+        }
+        return nowNs <= revealNs ? 0f : Math.min(1f, (nowNs - revealNs) / (float) REVEAL_NS);
+    }
+
+    public synchronized boolean isDone() {
+        return done;
+    }
+
+    /** Over, whether the desktop opened or the splash could not be drawn at all. */
+    public synchronized void finish() {
+        done = true;
+    }
+}
