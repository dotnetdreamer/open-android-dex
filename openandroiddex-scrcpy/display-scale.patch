+package com.genymobile.scrcpy.video;
+
+import java.io.BufferedReader;
+import java.io.FileReader;
+import java.io.IOException;
+
+/**
+ * The scale of the computer screen a flex display's window is on (Open Android DeX).
+ *
+ * <p>The client asks for its window's size in window coordinates, which are points on macOS and
+ * Wayland: on a 2x screen, half the pixels the window covers, so the display comes out at half
+ * resolution and is drawn twice as big. The computer writes the scale of the window's screen into
+ * {@link #FILE} before it starts the client, and again whenever the window moves to a screen of
+ * another scale. Each requested size is multiplied by it, so the display is the window's size in
+ * pixels; the client, started with {@code --render-fit=letterbox}, then shows it one for one.
+ *
+ * <p>No file means scale 1: stock behaviour.
+ */
+public final class DisplayScale {
+
+    public static final String FILE = "/data/local/tmp/oadx-display-scale";
+
+    private DisplayScale() {
+        // not instantiable
+    }
+
+    /** The scale in {@code text}'s first token: 1 for anything missing, unreadable or absurd. */
+    public static float parse(String text) {
+        if (text == null) {
+            return 1f;
+        }
+        String t = text.trim();
+        if (t.isEmpty()) {
+            return 1f;
+        }
+        try {
+            float scale = Float.parseFloat(t.split("\\s+")[0]);
+            return scale >= 0.5f && scale <= 8f ? scale : 1f;
+        } catch (NumberFormatException e) {
+            return 1f;
+        }
+    }
+
+    /** The scale the computer last wrote, or 1. */
+    public static float read() {
+        try (BufferedReader reader = new BufferedReader(new FileReader(FILE))) {
+            return parse(reader.readLine());
+        } catch (IOException | SecurityException e) {
+            return 1f;
+        }
+    }
+
+    /** One side of a requested size, in pixels. */
+    public static int toPixels(int side, float scale) {
+        return Math.max(1, Math.round(side * scale));
+    }
+
+    /** One side of the display, back in the window's coordinates. */
+    public static int toWindow(int side, float scale) {
+        return Math.max(1, Math.round(side / scale));
+    }
+}
