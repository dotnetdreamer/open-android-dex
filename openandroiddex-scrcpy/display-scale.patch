@@ -264,4 +264,51 @@ public final class WindowManager {
             Ln.e("Could not invoke method", e);
         }
     }
+
+    // Open Android DeX: a density forced on a display (`wm density -d`), see NewDisplayCapture
+
+    private static final int USER_CURRENT = -2; // android.os.UserHandle.USER_CURRENT
+
+    private Method getInitialDisplayDensityMethod;
+    private Method getBaseDisplayDensityMethod;
+    private Method clearForcedDisplayDensityMethod;
+
+    /** The density a display has with nothing forced on it, or -1. */
+    public int getInitialDisplayDensity(int displayId) {
+        try {
+            if (getInitialDisplayDensityMethod == null) {
+                getInitialDisplayDensityMethod = manager.getClass().getMethod("getInitialDisplayDensity", int.class);
+            }
+            return (int) getInitialDisplayDensityMethod.invoke(manager, displayId);
+        } catch (ReflectiveOperationException e) {
+            Ln.e("Could not invoke method", e);
+            return -1;
+        }
+    }
+
+    /** The density a display is at, forced or not, or -1. */
+    public int getBaseDisplayDensity(int displayId) {
+        try {
+            if (getBaseDisplayDensityMethod == null) {
+                getBaseDisplayDensityMethod = manager.getClass().getMethod("getBaseDisplayDensity", int.class);
+            }
+            return (int) getBaseDisplayDensityMethod.invoke(manager, displayId);
+        } catch (ReflectiveOperationException e) {
+            Ln.e("Could not invoke method", e);
+            return -1;
+        }
+    }
+
+    /** What `wm density reset -d` does: nothing forced on the display, for the current user. */
+    public void clearForcedDisplayDensity(int displayId) {
+        try {
+            if (clearForcedDisplayDensityMethod == null) {
+                clearForcedDisplayDensityMethod = manager.getClass()
+                        .getMethod("clearForcedDisplayDensityForUser", int.class, int.class);
+            }
+            clearForcedDisplayDensityMethod.invoke(manager, displayId, USER_CURRENT);
+        } catch (ReflectiveOperationException e) {
+            Ln.e("Could not invoke method", e);
+        }
+    }
 }
