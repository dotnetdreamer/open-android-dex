+    /**
+     * Open Android DeX: the rotation an Android 10 or 11 desktop is held at, taken off. There the
+     * computer holds a desktop at its own rotation (`wm set-user-rotation lock` and
+     * `wm set-fix-to-user-rotation enabled`), or a portrait app that stays full screen turns the whole
+     * desktop, and Android keeps both under the display's identity, as it keeps a forced density, for
+     * the next display that gets it, which no app could turn: anyone's own scrcpy display (the next
+     * desktop is held again anyway). So the hold comes off before the display goes, however the
+     * session ends, the desktop's window closed on the computer included; and a hold an earlier display
+     * left, its server killed before it got here, comes off each display made here. On Android 11 fixed
+     * to the user's rotation goes back to the display's default whatever it was: Android keeps
+     * "disabled" as it keeps "enabled". Android 10 cannot be given the default (see below).
+     *
+     * The frozen rotation comes off last, and only once the fixed half is off or refused by the shell,
+     * which no later try would change. Fixed alone still holds the display at its rotation
+     * (DisplayRotation.rotationForOrientation returns the user's rotation before anything else), and
+     * on Android 10 the freeze is all the next display made here can look for: thawed with the fixed
+     * half still on, the display would be held with nothing left to show it.
+     */
+    private static void releaseRotationHold(int displayId, String what) {
+        if (Build.VERSION.SDK_INT < AndroidVersions.API_29_ANDROID_10 || Build.VERSION.SDK_INT > AndroidVersions.API_30_ANDROID_11) {
+            return;
+        }
+        WindowManager wm = ServiceManager.getWindowManager();
+        boolean held = wm.isRotationFrozen(displayId);
+        boolean unfixed;
+        if (Build.VERSION.SDK_INT >= AndroidVersions.API_30_ANDROID_11) {
+            unfixed = wm.setFixedToUserRotationDefault(displayId) || setFixedToUserRotationByShell(displayId, "default");
+        } else {
+            unfixed = !held || setFixedToUserRotationByShell(displayId, "disabled");
+        }
+        if (!held) {
+            return;
+        }
+        if (!unfixed) {
+            Ln.w("Rotation hold " + what + " left on, for the next display made here to take off (display " + displayId + ")");
+            return;
+        }
+        wm.thawRotation(displayId);
+        Ln.i("Rotation hold " + what + " taken off (display " + displayId + ")");
+    }
+
+    /**
+     * Open Android DeX: `cmd window set-fix-to-user-rotation -d <id> <value>`, what the computer's `wm`
+     * runs. Android 10's window manager takes fixed to the user's rotation from that command only (no
+     * call outside its own process), and the command takes "default" as "disabled": as near to nothing
+     * kept as Android 10 comes. Nothing there reads the setting back, so there it only runs on a display
+     * found frozen, as the computer's hold always is (any freeze counts): run on every display, it
+     * would leave each one a setting of its own. On Android 11 it stands in for the window manager's
+     * call should that be missing. False only when the command did not get through to the window
+     * manager, as a later try may: `cmd` could not be run or was cut short, or could not reach the
+     * window manager (`cmd` then exits 20, or with a binder error). Exit code 255 is the window
+     * manager's own refusal (its shell command returned -1, or threw), the same at every try; on
+     * Android 10 the computer's own `enabled`, sent the same way, was then refused too, leaving only
+     * the freeze.
+     */
+    private static boolean setFixedToUserRotationByShell(int displayId, String value) {
+        String[] cmd = {"cmd", "window", "set-fix-to-user-rotation", "-d", String.valueOf(displayId), value};
+        try {
+            int exitCode = Runtime.getRuntime().exec(cmd).waitFor();
+            if (exitCode == 0) {
+                return true;
+            }
+            if (exitCode == 255) {
+                Ln.w("The window manager refused to take display " + displayId + " off the fixed rotation");
+                return true;
+            }
+            Ln.w("Could not take display " + displayId + " off the fixed rotation (exit code " + exitCode + ")");
+            return false;
+        } catch (IOException e) {
+            Ln.w("Could not take display " + displayId + " off the fixed rotation", e);
+            return false;
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            Ln.w("Could not take display " + displayId + " off the fixed rotation", e);
+            return false;
+        }
+    }
+
+    /**
+     * Open Android DeX: on Android 10 and 11 the window manager learns of a display a moment after it
+     * is made, applying then what it keeps under the display's identity, and until then answers as if
+     * there were no such display: a clear made before that would change nothing.
+     */
+    private static void awaitWindowManager(int displayId) {
+        if (Build.VERSION.SDK_INT > AndroidVersions.API_30_ANDROID_11) {
+            return;
+        }
+        WindowManager wm = ServiceManager.getWindowManager();
+        long start = SystemClock.uptimeMillis();
+        boolean slept = false;
+        while (wm.getInitialDisplayDensity(displayId) <= 0) {
+            if (SystemClock.uptimeMillis() - start >= 1000) {
+                Ln.w("Display " + displayId + " still unknown to the window manager after 1 s");
+                return;
+            }
+            SystemClock.sleep(5);
+            slept = true;
+        }
+        if (slept) {
+            Ln.i("Display " + displayId + " known to the window manager " + (SystemClock.uptimeMillis() - start) + " ms after it was made");
+        }
+    }
