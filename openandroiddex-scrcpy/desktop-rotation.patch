+    // Open Android DeX: an Android 10 or 11 desktop's rotation hold (`wm set-fix-to-user-rotation`), see NewDisplayCapture
+
+    private static final int FIXED_TO_USER_ROTATION_DEFAULT = 0; // android.view.IWindowManager.FIXED_TO_USER_ROTATION_DEFAULT
+
+    private Method setFixedToUserRotationMethod;
+
+    /**
+     * What `wm set-fix-to-user-rotation -d <id> default` does on Android 11: the display's own policy on apps' orientation
+     * again. False when the call could not be made. Android 10 has no such call outside the window manager's process (see
+     * NewDisplayCapture).
+     */
+    public boolean setFixedToUserRotationDefault(int displayId) {
+        try {
+            if (setFixedToUserRotationMethod == null) {
+                setFixedToUserRotationMethod = manager.getClass().getMethod("setFixedToUserRotation", int.class, int.class);
+            }
+            setFixedToUserRotationMethod.invoke(manager, displayId, FIXED_TO_USER_ROTATION_DEFAULT);
+            return true;
+        } catch (ReflectiveOperationException e) {
+            Ln.e("Could not invoke method", e);
+            return false;
+        }
+    }
