    <string name="ln_reinstall">Reinstall Linux…</string>
    <string name="ln_reinstall_body">This deletes the Ubuntu container completely — every app you installed and every file inside it — and installs a fresh one. The download is about 1 GB. Nothing outside Linux is affected.</string>
