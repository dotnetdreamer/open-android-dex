    <string name="ln_session_failed_sub">Something inside the container stopped it. Starting again gives you a fresh session.</string>
    <string name="ln_session_ended">You logged out of Linux</string>
    <string name="ln_session_ended_sub">The session is closed and the container has stopped. Nothing was lost from the installed system.</string>
    <string name="ln_session_start">Start a session</string>
    <string name="ln_close_title">Shut down Linux?</string>
    <string name="ln_close_body">This ends the Ubuntu session and stops the container. Anything unsaved inside it is lost. To put it aside and keep it running, minimise the window instead.</string>
    <string name="ln_close_cancel">Cancel</string>
    <string name="ln_close_shutdown">Shut down</string>
