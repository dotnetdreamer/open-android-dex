    <string name="ln_reinstall_started">Reinstalling Linux. Open the Linux window to watch it.</string>
    <string name="ln_uninstall">Uninstall Linux…</string>
    <string name="ln_uninstall_body">This deletes the Ubuntu container and frees the storage it was using — every app you installed and every file inside it. Linux will not reinstall itself; opening Linux again downloads it fresh. Your shared folder is kept, and nothing outside Linux is affected.</string>
    <string name="ln_uninstall_go">Uninstall</string>
    <string name="ln_uninstall_done">Linux uninstalled. The storage it was using is free.</string>
