<?xml version="1.0" encoding="utf-8"?>
<!--
  The taskbar's on-screen keyboard toggle. Drawn here because android.R has no
  public keyboard drawable, and the OEM-internal ones change names per device;
  a glyph (⌨) is no better — most phones render it as colour emoji, which will
  not take the accent tint the lit "on" state needs. White paths, tinted at
  runtime like the tray's other ImageViews.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Body: rounded outer rect minus the inner face. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M4,6 H20 C21.105,6 22,6.895 22,8 V16 C22,17.105 21.105,18 20,18 H4 C2.895,18 2,17.105 2,16 V8 C2,6.895 2.895,6 4,6 Z M3.5,7.5 V16.5 H20.5 V7.5 Z" />

    <!-- Two rows of keys, then modifier · space bar · modifier. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M5,9 h1.5 v1.5 h-1.5 z M7.4,9 h1.5 v1.5 h-1.5 z M9.8,9 h1.5 v1.5 h-1.5 z M12.2,9 h1.5 v1.5 h-1.5 z M14.6,9 h1.5 v1.5 h-1.5 z M17,9 h1.5 v1.5 h-1.5 z M5,11.4 h1.5 v1.5 h-1.5 z M7.4,11.4 h1.5 v1.5 h-1.5 z M9.8,11.4 h1.5 v1.5 h-1.5 z M12.2,11.4 h1.5 v1.5 h-1.5 z M14.6,11.4 h1.5 v1.5 h-1.5 z M17,11.4 h1.5 v1.5 h-1.5 z M5,13.8 h1.5 v1.5 h-1.5 z M8.2,13.8 h7.6 v1.5 h-7.6 z M17,13.8 h1.5 v1.5 h-1.5 z" />
</vector>
