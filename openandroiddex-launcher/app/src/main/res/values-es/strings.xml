    <string name="ln_connect_failed">No se puede acceder al escritorio Linux</string>
    <string name="ln_retry">Reintentar</string>
    <string name="ln_cannot_open">No se puede abrir Linux</string>
    <string name="ln_reinstall">Reinstalar Linux…</string>
    <string name="ln_reinstall_body">Esto borra por completo el contenedor de Ubuntu — todas las apps que instalaste y todos los archivos que hay dentro — e instala uno nuevo. La descarga es de aproximadamente 1 GB. Nada fuera de Linux se ve afectado.</string>
    <string name="ln_reinstall_go">Borrar y reinstalar</string>
    <string name="ln_reinstall_started">Reinstalando Linux. Abre la ventana de Linux para verlo.</string>
    <string name="ln_session_failed">La sesión de Linux terminó inesperadamente</string>
    <string name="ln_session_failed_sub">Algo dentro del contenedor la detuvo. Al empezar de nuevo tendrás una sesión limpia.</string>
    <string name="ln_session_ended">Cerraste la sesión de Linux</string>
    <string name="ln_session_ended_sub">La sesión está cerrada y el contenedor detenido. No se perdió nada del sistema instalado.</string>
    <string name="ln_session_start">Iniciar sesión</string>
    <string name="ln_close_title">¿Apagar Linux?</string>
    <string name="ln_close_body">Esto termina la sesión de Ubuntu y detiene el contenedor. Se perderá todo lo que no esté guardado dentro. Para dejarla a un lado sin detenerla, minimiza la ventana.</string>
    <string name="ln_close_cancel">Cancelar</string>
    <string name="ln_close_shutdown">Apagar</string>
    <string name="ln_close_body_phone">Esto finaliza la sesión de Ubuntu y detiene el contenedor. Se pierde todo lo que no esté guardado dentro. «Mantener en marcha» lo deja funcionando en segundo plano para que puedas volver.</string>
    <string name="ln_close_keep">Mantener en marcha</string>
    <string name="ln_on_desktop">Linux ya está abierto en el escritorio DeX. Ciérralo allí para usarlo en el teléfono.</string>
    <string name="ln_shared">Carpeta compartida</string>
    <string name="ln_shared_grant">Permitir acceso a todos los archivos…</string>
    <string name="ln_shared_grant_failed">No se puede abrir la pantalla de permisos</string>
    <string name="ln_shared_where">Carpeta compartida: %1$s</string>
    <string name="ln_shared_grant_title">Permitir acceso a todos los archivos</string>
    <string name="ln_shared_grant_body">La carpeta compartida está en la raíz del almacenamiento interno. Android solo permite que una app cree una carpeta ahí — o lea los archivos que copias dentro — con este permiso.

Sin él no hay carpeta compartida en absoluto.

Si lo desactivas más adelante, Android cerrará Linux a la fuerza y el escritorio se reiniciará.</string>
    <string name="ln_shared_grant_go">Abrir ajustes</string>

