    <string name="ln_label">LinuxOnDroid</string>
    <!-- Linux: what goes into the container, asked before the download starts -->
    <string name="ln_apps_title">Elige qué instalar</string>
    <string name="ln_apps_body">Ubuntu y el escritorio XFCE se instalan siempre. Desmarca lo que no quieras y no se descargará.</string>
    <string name="ln_apps_body_again">Ubuntu y el escritorio XFCE ya están instalados. Marca lo que quieras añadir. Desmarcar no borra lo que ya está ahí.</string>
    <string name="ln_apps_firefox">Firefox</string>
    <string name="ln_apps_firefox_sub">Navegador web de Mozilla. Una descarga grande.</string>
    <string name="ln_apps_chromium">Chromium</string>
    <string name="ln_apps_chromium_sub">Navegador web. Una descarga grande.</string>
    <string name="ln_apps_code">Visual Studio Code</string>
    <string name="ln_apps_code_sub">Editor de código de Microsoft. Una descarga grande.</string>
    <string name="ln_apps_git">Git</string>
    <string name="ln_apps_git_sub">Pequeño. VS Code lo necesita para el panel de control de código fuente.</string>
    <string name="ln_apps_node">Node.js</string>
    <string name="ln_apps_node_sub">Entorno de ejecución de JavaScript con npm. La versión LTS actual.</string>
    <string name="ln_apps_gimp">GIMP</string>
    <string name="ln_apps_gimp_sub">Editor de imágenes para fotos y gráficos. Una descarga grande.</string>
    <string name="ln_apps_intellij">IntelliJ IDEA Community</string>
    <string name="ln_apps_intellij_sub">IDE de Java de JetBrains. La descarga más grande de aquí.</string>
