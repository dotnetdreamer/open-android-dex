    <string name="wb_label">Visionneuse web</string>
    <string name="wb_subtitle">Ouvrez ce bureau dans un navigateur sur un autre ordinateur — rien à y installer.</string>
    <string name="wb_start">Démarrer</string>
    <string name="wb_stop">Arrêter</string>
