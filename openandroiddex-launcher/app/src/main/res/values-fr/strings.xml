    <string name="wb_access">Code d’accès</string>
    <string name="wb_access_note">Le navigateur le demande une fois. Il n’est jamais envoyé dans un lien ni affiché ailleurs.</string>
    <string name="wb_new_code">Nouveau code</string>
    <string name="wb_new_code_done">Nouveau code défini — toutes les sessions ont été fermées</string>
    <string name="wb_allow_control">Autoriser le contrôle</string>
    <string name="wb_allow_control_sub">Les clics deviennent des touchers et la saisie va au champ qui a le focus. Désactivé, l’écran est en lecture seule.</string>
    <string name="wb_control_needs_service">Le contrôle nécessite le service d’accessibilité d’Open Android DeX, qui est désactivé. Activez-le dans Paramètres → Accessibilité.</string>
    <string name="wb_allow_files">Autoriser les fichiers</string>
    <string name="wb_allow_files_sub">Parcourez et téléchargez depuis le téléphone, et déposez des fichiers sur la page pour les envoyer ici.</string>
    <string name="wb_files_limited">Sans l’accès à tous les fichiers, la page ne peut qu’envoyer des fichiers dans Téléchargements, pas parcourir le stockage.</string>
    <string name="wb_picture">Image</string>
    <string name="wb_q_720">Jusqu’à 720p</string>
    <string name="wb_q_1080">Jusqu’à 1080p</string>
    <string name="wb_q_native">Taille réelle</string>
    <string name="wb_fps">Images par seconde</string>
    <string name="wb_bitrate">Débit (Mb/s)</string>
    <string name="wb_picture_note">Plus grand et plus rapide coûte de la batterie et de la bande passante. WebRTC réduit de lui-même sur un lien faible : ce sont des plafonds, pas des promesses.</string>
    <string name="wb_restart_needed">Arrêtez puis redémarrez la visionneuse pour appliquer cela</string>
    <string name="wb_security_note">Quiconque a le code d’accès peut voir et contrôler ce téléphone. La vidéo, les clics et les fichiers circulent chiffrés entre les deux extrémités ; la capture d’écran peut être arrêtée à tout moment depuis la notification.</string>
