    <string name="ln_label">LinuxOnDroid</string>
    <string name="ln_installing">Instalando o Ubuntu…</string>
    <string name="ln_waiting">Aguardando o aplicativo do computador iniciar a instalação…</string>
    <string name="ln_starting">Iniciando o desktop Linux…</string>
    <string name="ln_stage_display">Iniciando o servidor de exibição…</string>
    <string name="ln_stage_services">Iniciando os serviços do desktop…</string>
    <string name="ln_stage_connecting">Conectando ao desktop…</string>
    <string name="ln_error">Falha na configuração do Linux</string>
