    <string name="ln_label">LinuxOnDroid</string>
    <!-- Linux: what goes into the container, asked before the download starts -->
    <string name="ln_apps_title">Wähle aus, was installiert wird</string>
    <string name="ln_apps_body">Ubuntu und der XFCE-Desktop kommen immer mit. Entferne den Haken bei allem, was du nicht willst — es wird dann nicht heruntergeladen.</string>
    <string name="ln_apps_body_again">Ubuntu und der XFCE-Desktop sind bereits installiert. Setze einen Haken bei allem, was hinzukommen soll. Ein entfernter Haken löscht nichts.</string>
    <string name="ln_apps_firefox">Firefox</string>
    <string name="ln_apps_firefox_sub">Webbrowser von Mozilla. Ein großer Download.</string>
    <string name="ln_apps_chromium">Chromium</string>
    <string name="ln_apps_chromium_sub">Webbrowser. Ein großer Download.</string>
    <string name="ln_apps_code">Visual Studio Code</string>
    <string name="ln_apps_code_sub">Code-Editor von Microsoft. Ein großer Download.</string>
    <string name="ln_apps_git">Git</string>
    <string name="ln_apps_git_sub">Klein. VS Code braucht es für die Quellcodeverwaltung.</string>
    <string name="ln_apps_node">Node.js</string>
    <string name="ln_apps_node_sub">JavaScript-Laufzeit mit npm. Die aktuelle LTS-Version.</string>
    <string name="ln_apps_gimp">GIMP</string>
    <string name="ln_apps_gimp_sub">Bildbearbeitung für Fotos und Grafiken. Ein großer Download.</string>
    <string name="ln_apps_intellij">IntelliJ IDEA Community</string>
    <string name="ln_apps_intellij_sub">Java-IDE von JetBrains. Der größte Download hier.</string>
    <string name="ln_apps_go">Installieren</string>
    <string name="ln_apps_go_none">Nur Ubuntu installieren</string>
    <string name="ln_apps_menu">Linux-Apps auswählen…</string>
    <string name="ln_installing">Ubuntu wird installiert…</string>
    <string name="ln_waiting">Warten, bis die Desktop-App die Installation startet…</string>
    <string name="ln_starting">Linux-Desktop wird gestartet…</string>
    <string name="ln_stage_display">Anzeigeserver wird gestartet…</string>
    <string name="ln_stage_services">Desktop-Dienste werden gestartet…</string>
    <string name="ln_stage_connecting">Verbindung zum Desktop wird hergestellt…</string>
    <string name="ln_error">Linux-Einrichtung fehlgeschlagen</string>
    <string name="ln_connect_failed">Linux-Desktop ist nicht erreichbar</string>
    <string name="ln_retry">Erneut versuchen</string>
    <string name="ln_cannot_open">Linux kann nicht geöffnet werden</string>
    <string name="ln_reinstall">Linux neu installieren…</string>
    <string name="ln_reinstall_body">Damit wird der Ubuntu-Container vollständig gelöscht — jede installierte App und jede Datei darin — und ein frischer installiert. Der Download beträgt etwa 1 GB. Alles außerhalb von Linux bleibt unberührt.</string>
    <string name="ln_reinstall_go">Löschen und neu installieren</string>
    <string name="ln_reinstall_started">Linux wird neu installiert. Öffne das Linux-Fenster, um zuzusehen.</string>
    <string name="ln_uninstall">Linux deinstallieren…</string>
    <string name="ln_uninstall_body">Damit wird der Ubuntu-Container gelöscht und der belegte Speicher freigegeben — jede installierte App und jede Datei darin. Linux installiert sich nicht von selbst neu; beim erneuten Öffnen wird es frisch heruntergeladen. Der gemeinsame Ordner bleibt erhalten, und alles außerhalb von Linux bleibt unberührt.</string>
    <string name="ln_uninstall_go">Deinstallieren</string>
    <string name="ln_uninstall_done">Linux wurde deinstalliert. Der belegte Speicher ist frei.</string>
    <string name="ln_session_failed">Die Linux-Sitzung wurde unerwartet beendet</string>
    <string name="ln_session_failed_sub">Etwas im Container hat sie gestoppt. Ein Neustart gibt dir eine frische Sitzung.</string>
    <string name="ln_session_ended">Du hast dich von Linux abgemeldet</string>
    <string name="ln_session_ended_sub">Die Sitzung ist geschlossen und der Container gestoppt. Am installierten System ging nichts verloren.</string>
    <string name="ln_session_start">Sitzung starten</string>
    <string name="ln_close_title">Linux herunterfahren?</string>
    <string name="ln_close_body">Damit endet die Ubuntu-Sitzung und der Container wird gestoppt. Alles nicht Gespeicherte darin geht verloren. Um sie beiseitezulegen und weiterlaufen zu lassen, minimiere stattdessen das Fenster.</string>
    <string name="ln_close_cancel">Abbrechen</string>
    <string name="ln_close_shutdown">Herunterfahren</string>
    <string name="ln_close_body_phone">Damit endet die Ubuntu-Sitzung und der Container wird gestoppt. Alles nicht Gespeicherte darin geht verloren. „Weiterlaufen lassen“ lässt sie im Hintergrund weiterlaufen, sodass du zurückkehren kannst.</string>
    <string name="ln_close_keep">Weiterlaufen lassen</string>
    <string name="ln_on_desktop">Linux ist bereits auf dem DeX-Desktop geöffnet. Schließe es dort, um es auf dem Telefon zu nutzen.</string>
    <string name="ln_shared">Gemeinsamer Ordner</string>
    <string name="ln_shared_grant">Zugriff auf alle Dateien erlauben…</string>
    <string name="ln_shared_grant_failed">Der Berechtigungsbildschirm kann nicht geöffnet werden</string>
    <string name="ln_shared_where">Gemeinsamer Ordner: %1$s</string>
    <string name="ln_shared_grant_title">Zugriff auf alle Dateien erlauben</string>
    <string name="ln_shared_grant_body">Der gemeinsame Ordner liegt direkt im internen Speicher. Android erlaubt einer App nur mit dieser Berechtigung, dort einen Ordner anzulegen — oder die Dateien zu lesen, die du hineinkopierst.

Ohne sie gibt es gar keinen gemeinsamen Ordner.

Wenn du sie später wieder abschaltest, erzwingt Android das Beenden von Linux und der Desktop startet neu.</string>
    <string name="ln_shared_grant_go">Einstellungen öffnen</string>

