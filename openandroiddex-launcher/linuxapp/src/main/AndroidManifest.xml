<?xml version="1.0" encoding="utf-8"?>
<!--
  LinuxOnDroid, standalone. The whole difference between this app and the
  desktop shell is this file: same code, same resources, same proot — a home
  screen to start Linux from (LinuxHomeActivity, which only this app has), the
  Linux window and its service, plus remote access's window and receiver,
  instead of a dozen components, and only the permissions those need.

  What is deliberately NOT here, and why nothing misses it: the shell
  (LauncherActivity, CaptionService, the taskbar's window daemon), the Web
  viewer, Docker, and RequestProvider. Their classes are still compiled in —
  excluding sources would mean forking the tree — but a component the manifest
  does not declare cannot be started by anyone, including us. RequestProvider is
  the one that MUST go rather than merely may: its authority is a fixed string,
  and two installed apps declaring the same authority is
  INSTALL_FAILED_CONFLICTING_PROVIDER — the second install simply fails.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Remote desktop's phone helper started with no computer
         (PhoneHelperStart): the helper's first run, as the shell, grants
         this so the app can switch the phone's Wireless debugging on by
         itself when a computer needs the helper, and off again after. Never
         granted without that pairing; nothing else writes secure settings. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Downloading the Ubuntu rootfs, apt inside the guest, and the loopback
         socket the noVNC page is served over. Without it an app cannot create
         ANY socket. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The Linux runtime (proot → Xvnc + websockify) is a long-running native
         process tree this app owns; it lives in a foreground service so Android
         does not reap it while the window is backgrounded — which, on a phone,
         is what "keep running" does. specialUse: a self-hosted Linux container
         is none of the predefined FGS types. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Remote desktop: this phone's screen, shared with a computer while the
         user allows it (PhoneRemoteService). Android asks each time, and shows
         that the screen is being shared for as long as it is. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Remote desktop's sound: what apps play on the phone, for the computer
         that has it open, only while the person there chooses sound
         (PhoneSound). Android's playback capture needs the microphone's
         permission, asked at runtime with the app's own words first; the
         microphone is never opened. MODIFY_AUDIO_SETTINGS: the phone's own
         media sound muted while the computer asks for it there alone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- RECORD_AUDIO makes Google Play treat a microphone as required, and it
         left out the phones and tablets without one (6 devices for 0.3.38).
         The microphone is never used: not required. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Asked for at runtime, once, by LinuxActivity — the only permission
         dialog this app raises. The service runs either way; without the grant
         Android just hides its notification, which on a phone is the only sign
         a container is running and the way back to a session put aside. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The shared folder at /sdcard/LinuxOnDeX, which linux-rt.sh binds into
         the guest's Desktop. MediaProvider gates top-level names on shared
         storage, so without this the folder cannot even be created, and scoped
         storage denies us open() on anything another app put there.

         DECLARED but never asked for: there is no in-app screen to request it
         (that lives in the desktop shell), so this is the user's own trip to
         Settings → Apps → Special app access → All files access. Everything
         else about the container works without it; only the shared folder is
         missing until then. Declaring it is what makes the grant STICK when
         they do — PermissionPolicyService resets an app-op-backed permission
         the package never requested.

         Play allows it only for file managers, backup, antivirus and the
         like, so the Play (release) build removes it again in
         src/release/AndroidManifest.xml and goes without the shared folder
         (Linux.sharedFolderOffered). Debug builds, the GitHub APK among them,
         keep both. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Android 10 has no "All files access": there the phone's own files
         (Remote desktop's Files in a browser) and the shared folder come
         through the older storage permission, Android's own two-button
         question, with legacy storage on (requestLegacyExternalStorage
         below, which Android 10 honours and Android 11 ignores). Never
         asked on Android 11 and newer. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Remote access: SSH into this Linux from a computer anywhere. The same
         four the desktop build declares, for the same reasons (see its
         manifest): the network watch native code cannot do on Android, a wake
         lock while a computer is connected, coming back after a reboot, and
         the battery exemption the Remote access window asks for. This app is
         the one most likely to be left running as a pocket server, which is
         exactly the case these exist for. RECEIVE_BOOT_COMPLETED also serves
         Settings' "Start Linux with the phone". -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- The shared folder's file manager (Linux.sharedFolderIntent, from the
         home screen's tile). From Android 11 a query sees only the apps a
         manifest says it looks for, and this one would otherwise come back
         empty and leave the tile showing a path instead of the folder. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
    </queries>

    <!-- label + icon are the product's, not the shell's: this app IS
         LinuxOnDroid, so it says so in the app list, in Settings → Apps, and on
         the recents card.

         networkSecurityConfig: targetSdk 35 blocks cleartext http, which
         includes the loopback noVNC page the viewer loads. The config permits
         cleartext for 127.0.0.1 and nothing else.

         extractNativeLibs: proot must be a real file in nativeLibraryDir to be
         exec'd — see build.gradle's useLegacyPackaging.

         Theme.LinuxOnDroid is the shell's theme on this app's page colour,
         with this app's own icon on the splash rather than the desktop's. -->
    <!-- supportsRtl: Arabic is one of this app's languages, and without it
         Android lays every screen out left to right whatever the language.
         The desktop build does not set it; its shell is not mirrored. -->
    <!-- enableOnBackInvokedCallback="false": this app targets 36 (Play's
         floor, see build.gradle), and from Android 16 a target-36 app no
         longer gets onBackPressed or KEYCODE_BACK unless it opts out. Without
         them, Back on the Linux window would skip its "keep Linux running?"
         question and finish() it, and finishing it stops the container: one
         key press ending a live session or a 1.5 GB install. Opting out keeps
         Back exactly as it was at 35, on every Android version. -->
    <application
        android:label="@string/ln_label"
        android:icon="@mipmap/ic_linux"
        android:extractNativeLibs="true"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.LinuxOnDroid">

        <!-- The launcher entry: the home screen, where Linux is started from
             and where what it is doing is shown. This app's alone; the desktop
             build's Linux entries open the window straight away, and so does
             the trampoline below. singleTop, so tapping the icon while it is
             in front does not stack a second one.

             configChanges: turning the phone, folding it or resizing the window
             re-lays the page out in place rather than rebuilding it, which
             would type the terminal out again. -->
        <activity
            android:name=".LinuxHomeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The way in that skips the home screen and starts Linux at once. It
             was the launcher entry before the home screen existed, and it is
             still the trampoline the desktop build puts in the phone's app
             list, because it owns the two things opening Linux means: clearing
             the uninstall marker, and raising the one window there is instead
             of building another. See LinuxAppActivity.

             The ongoing notification opens it, and an Open Android DeX desktop
             will, to start this app's Linux without a stop at the home screen.
             Exported for that, and safe to be: everything it can do is what
             the Start button does. No intent filter, so it is reached by name
             and never listed. -->
        <activity
            android:name=".LinuxAppActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.open"
            android:theme="@style/Theme.OpenAndroidDeX.Detour"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection|fontScale" />

        <!-- The window itself: the noVNC viewer over the container, plus the
             install narration in front of it. Not exported — it is reached
             from the home screen's Start, and through the trampoline above.

             taskAffinity is this app's own. The string differs from the desktop
             build's on purpose: affinity is matched by string, and two installed
             apps offering the same one is a way for a window to be pulled into
             a task that is not its own. Built from ${applicationId} for the
             same reason: the Play build (com.dotnetdreamer.linuxondroid) and
             the GitHub one (com.ccrstech.linuxondroid) can both be installed,
             and a fixed string would be shared between them.

             adjustResize, spelled out because the default is not it: an
             unspecified soft-input mode resolves to PAN, which slides the whole
             window up when the keyboard opens and takes the viewer's control
             bar off the top of the screen. Resizing lets the page see the space
             it has left and put its key row above the keyboard.

             label: what its card says in recent apps, where it sits beside the
             home screen's, which carries the app's name. -->
        <activity
            android:name=".LinuxActivity"
            android:exported="false"
            android:icon="@mipmap/ic_linux"
            android:label="@string/hm_window_label"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.window"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- Settings: Start Linux with the phone, and Use the GPU. Reached from
             the home screen's menu, in the home screen's own task (no
             affinity of its own), so Back returns there. -->
        <activity
            android:name=".LinuxSettingsActivity"
            android:exported="false"
            android:label="@string/settings_label"
            android:resizeableActivity="true" />

        <!-- The Remote access window. Reached from the viewer's control bar and
             from the notification; an affinity of this app's own, like the
             window's, for the reason spelled out there. -->
        <activity
            android:name=".LinuxRemoteActivity"
            android:exported="false"
            android:icon="@mipmap/ic_linux"
            android:label="@string/rm_label"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.remote"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- Brings remote access back after a reboot or an update, and at a
             boot starts the desktop when Settings' "Start Linux with the
             phone" is on (LinuxBoot). Guarded by DUMP like the desktop
             build's: the system sends these, apps may not. -->
        <receiver
            android:name=".RemoteResumeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Owns the whole container: downloads and verifies the rootfs, runs
             the apt provisioning, and hosts the proot/Xvnc/websockify runtime,
             all under this app's own uid. No shell user, no daemon, no PC —
             which is what makes this app a repackage rather than a rewrite.

             Its own process, as in the desktop build: a foreground service that
             misses the platform's five-second startForeground deadline dies
             with an uncaught ForegroundServiceDidNotStartInTimeException, and
             sharing a process meant that took the window down with it. -->
        <service
            android:name=".LinuxService"
            android:exported="false"
            android:process=":linux"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-launched Linux (Ubuntu/XFCE) container under proot" />
        </service>

        <!-- The Linux apps the desktop starts, in an Android process apart from
             the desktop, as in the desktop build: when the phone has more than
             32 processes started by apps, Android closes this process's first,
             so an app goes and the desktop stays (doc/linux-apps-process.md). -->
        <service
            android:name=".LinuxAppsService"
            android:exported="false"
            android:process=":linuxapps" />
        <!-- Remote desktop: this phone's own screen, seen and used from a
             computer the user paired with (doc/phone-remote.md). Three pieces,
             all in the app's own process, so a pointer move never crosses a
             process on its way to the screen.

             The screen sharing: Android's consent (PhoneConsentActivity, the
             system's dialog and nothing of ours), then the projection held in
             a mediaProjection foreground service, with its notification. -->
        <service
            android:name=".PhoneRemoteService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- The stream listening while Remote desktop is on with neither
             control nor screen sharing there to hold it (after the app was
             stopped): a computer then finds a stream that asks the phone. -->
        <service
            android:name=".PhoneListenService"
            android:exported="false" />

        <!-- "Email me when an address changes" (EmailNotice,
             doc/address-email.md): the job that waits for a change to
             settle, sends one email with the new addresses, and tries again
             when there is no network; and the look every quarter of an hour
             that needs no callback from Android. Persisted (which is why
             RECEIVE_BOOT_COMPLETED above matters here too), so a restart or
             an update loses neither. -->
        <service
            android:name=".EmailNoticeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name=".PhoneConsentActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenAndroidDeX.Detour"
            android:taskAffinity="${applicationId}.phone"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <!-- Android's question for Remote desktop's sound (PhoneSound), and
             nothing of its own. -->
        <activity
            android:name=".PhoneSoundActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenAndroidDeX.Detour"
            android:taskAffinity="${applicationId}.phone"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <!-- The control: a computer's mouse and keyboard, as touches and
             typing (PhoneInput). Switched on by the user in Android's
             accessibility settings, after this app's own words on what it does
             (the Settings page), never by the app. -->
        <service
            android:name=".PhoneControlService"
            android:exported="false"
            android:label="@string/pr_control_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/phone_control" />
        </service>

        <!-- Turns the screen on for a computer that opened a sleeping phone,
             over the lock screen, and goes at once. -->
        <activity
            android:name=".PhoneWakeActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenAndroidDeX.Detour"
            android:taskAffinity="${applicationId}.wake"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:noHistory="true" />

        <!-- Where a helper the app started itself (PhoneHelper's register mode)
             hands over its port and key, with the shell's `content call`.
             DUMP guards it (the shell holds it, no app is given it), and
             PhoneHelperDoor believes the shell's and root's uid only. -->
        <provider
            android:name=".PhoneHelperDoor"
            android:authorities="${applicationId}.helper"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- The pairing code typed into the pairing notification's box. -->
        <receiver
            android:name=".PhoneHelperStart$CodeReceiver"
            android:exported="false" />

        <!-- Android's alarm for switching Wireless debugging off again, when
             the app switched it on for Screen off's helper: it still comes
             if the app's process died in the meantime. -->
        <receiver
            android:name=".PhoneHelperStart$SwitchOffReceiver"
            android:exported="false" />
    </application>
</manifest>
