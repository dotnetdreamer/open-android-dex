+/*
+ * Bring the renderer up once, the way the first client would, say what it is
+ * running on, and take it down again. For whoever starts the server: a host
+ * whose EGL or GLES cannot carry virgl fails here, before any guest app has
+ * been pointed at a server that would turn every GL context it asks for down.
+ * One line on stdout, "probe ok: ..." on success.
+ */
+int vtest_probe_renderer(int ctx_flags, const char *render_device)
+{
+   uint32_t max_ver = 0, max_size = 0;
+   union virgl_caps *caps;
+
+   if (vtest_init_renderer(false, ctx_flags, render_device))
+      return -1;
+
+   virgl_renderer_get_cap_set(2, &max_ver, &max_size);
+   caps = max_size ? calloc(1, max_size > sizeof(*caps) ? max_size : sizeof(*caps)) : NULL;
+   if (!caps) {
+      fprintf(stderr, "probe: no virgl caps\n");
+      vtest_cleanup_renderer();
+      return -1;
+   }
+   virgl_renderer_fill_caps(2, 1, caps);
+   /* renderer[] is not promised to be terminated: bounded by the precision. */
+   printf("probe ok: renderer=\"%.64s\" glsl=%u caps=v%u\n",
+          caps->v2.renderer, caps->v2.v1.glsl_level, max_ver);
+   fflush(stdout);
+   free(caps);
+   vtest_cleanup_renderer();
+   return 0;
+}
+
 static void vtest_free_context(struct vtest_context *ctx, bool cleanup);
 
 void vtest_cleanup_renderer(void)
