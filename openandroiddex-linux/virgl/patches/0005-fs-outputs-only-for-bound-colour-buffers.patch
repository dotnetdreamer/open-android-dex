+/* How many colour outputs a shader that writes all colour buffers declares:
+ * the buffers bound, at least one, at most the host's limit. Declaring all
+ * max_draw_buffers of them, as before, made an Adreno 512's GLES compiler
+ * refuse every such shader ("Output fsout_c1 location or component exceeds
+ * max allowed", a Redmi Note 7 on Android 10), and outputs past the bound
+ * buffers are dropped anyway. */
+static int fs_cbuf_count(const struct dump_ctx *ctx)
+{
+   int n = ctx->key->fs.nr_cbufs;
+   if (n < 1)
+      n = 1;
+   if (n > ctx->cfg->max_draw_buffers)
+      n = ctx->cfg->max_draw_buffers;
+   return n;
+}
+
 static void emit_cbuf_writes(const struct dump_ctx *ctx,
                              struct vrend_glsl_strbufs *glsl_strbufs)
 {
    int i;
 
-   for (i = ctx->num_outputs; i < ctx->cfg->max_draw_buffers; i++) {
+   for (i = ctx->num_outputs; i < fs_cbuf_count(ctx); i++) {
       emit_buff(glsl_strbufs, "fsout_c%d = fsout_c0;\n", i);
    }
 }
