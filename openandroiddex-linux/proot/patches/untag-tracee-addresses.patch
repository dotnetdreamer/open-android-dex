 #include "build.h"           /* HAVE_PROCESS_VM,  */
 #include "cli/note.h"
 
+/**
+ * Return @address without the tag Android puts in the top byte of
+ * 64-bit heap pointers (Top Byte Ignore, Android 11 and later).  A
+ * tracee passes such pointers in its system call arguments, and on
+ * some kernels PTRACE_PEEKDATA fails with EIO on a tagged address
+ * (Linux 6.1 on a Galaxy S24, measured).  This build has no
+ * process_vm_readv(2), which accepts one, so every read of a heap
+ * string failed, starting with the path of the very first execve(2).
+ * PTRACE_POKEDATA takes the same kernel path.  The top byte is never
+ * part of an AArch64 user address, so dropping it changes nothing for
+ * an untagged pointer.
+ */
+#if defined(ARCH_ARM64)
+#define UNTAG(address) ((word_t)(address) & 0x00FFFFFFFFFFFFFFULL)
+#else
+#define UNTAG(address) ((word_t)(address))
+#endif
+
 #ifdef HAS_POKEDATA_WORKAROUND
 
 #include "tracee/reg.h"
